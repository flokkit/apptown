# /etc/forge/forged.env: forged's settings, one FORGE_ variable per flag
# (forged -h lists them all). Replace example.com and the paths.

# Sign-in: internal accounts. The first administrator is created with the
# setup token forged writes to $FORGE_DATA/setup-token on first start.
FORGE_AUTH=internal
# Loopback: a TLS proxy in front (Caddy, nginx) serves the public address.
FORGE_ADDR=127.0.0.1:7777
FORGE_PUBLIC_HOST=https://forge.example.com
FORGE_DATA=/var/lib/forge
# The console listener agents' chats reach; an address containers can reach.
FORGE_CONSOLE_ADDR=172.17.0.1:7778
# Model access for agents: a private listener containers reach, and the
# networks allowed to use it (Running a forge, Configure model access).
FORGE_INFERENCE_ADDR=172.17.0.1:7779
FORGE_INFERENCE_URL=http://172.17.0.1:7779
FORGE_INFERENCE_NETWORKS=172.17.0.0/16
# Without FORGE_DB_URL forged runs its own PostgreSQL in Docker.
# FORGE_DB_URL=postgres://forge:secret@db.example.com/forge?sslmode=require
# Work on a separate worker (Running a forge, Workers):
# FORGE_WORKER_URL=https://worker.example.com:7790
# FORGE_WORKER_CERT=/etc/forge/worker/client.pem
# FORGE_WORKER_KEY=/etc/forge/worker/client-key.pem
# FORGE_WORKER_CA=/etc/forge/worker/ca.pem
