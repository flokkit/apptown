# /etc/apptown/apptownd.env: apptownd's settings, one APPTOWN_ variable per flag
# (apptownd -h lists them all). Replace example.com and the paths.

# Sign-in: internal accounts. The first administrator is created with the
# setup token apptownd writes to $APPTOWN_DATA/setup-token on first start.
APPTOWN_AUTH=internal
# Loopback: a TLS proxy in front (Caddy, nginx) serves the public address.
APPTOWN_ADDR=127.0.0.1:7777
APPTOWN_PUBLIC_HOST=https://forge.example.com
APPTOWN_DATA=/var/lib/apptown
# The console listener agents' chats reach; an address containers can reach.
APPTOWN_CONSOLE_ADDR=172.17.0.1:7778
# Model access for agents needs no setting here: AppTown listens on
# docker0's address and allows this Docker's networks. Set all three
# APPTOWN_INFERENCE_ADDR, _URL and _NETWORKS only when Docker uses its own
# address pools (Setting up a server, Configure model access).
# The agent image, pulled from the registry when it is missing. Set it to the
# release you installed; set it again on each upgrade.
APPTOWN_AGENT_IMAGE=ghcr.io/flokkit/apptown-agent:<version>
# Without APPTOWN_DB_URL apptownd runs its own PostgreSQL in Docker.
# APPTOWN_DB_URL=postgres://apptown:secret@db.example.com/apptown?sslmode=require
# Work on a separate worker (Split install):
# APPTOWN_WORKER_URL=https://worker.example.com:7790
# APPTOWN_WORKER_CERT=/etc/apptown/worker/client.pem
# APPTOWN_WORKER_KEY=/etc/apptown/worker/client-key.pem
# APPTOWN_WORKER_CA=/etc/apptown/worker/ca.pem
