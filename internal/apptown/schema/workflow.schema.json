      "const": "apptown.dev/v1",
      "description": "The format version; absent means this one."
    },
    "kind": {
      "const": "Workflow"
    },
    "metadata": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "category": {
          "enum": [
            "change",
            "landing",
            "maintenance",
            "integration",
            "knowledge"
