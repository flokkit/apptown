{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flokkit.io/schemas/workflow-v1.json",
  "title": "AppTown workflow (apiVersion apptown.dev/v1)",
  "description": "A workflow as a team saves it. Rules a schema cannot express (unique stage and step names, gate references, role-specific rules) are AppTown's; a save checks them, and POST /api/v1/workflows/validate reports them without saving.",
  "type": "object",
  "required": [
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false,
  "patternProperties": {
    "^x-": {
      "description": "Ignored; a place for YAML anchors the document reuses."
    }
  },
  "properties": {
    "apiVersion": {
      "const": "apptown.dev/v1",
      "description": "The format version; absent means this one."
    },
    "kind": {
      "const": "Workflow"
    },
    "metadata": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "category": {
          "enum": [
            "change",
            "landing",
            "maintenance",
            "integration",
            "knowledge"
          ]
        },
        "deprecated": {
          "type": "boolean"
        },
        "project": {
          "type": "string"
        },
        "system": {
          "type": "boolean"
        },
        "tier": {
          "enum": [
            "core",
            "extra"
          ]
        },
        "title": {
          "type": "string"
        }
      }
    },
    "spec": {
      "type": "object",
      "required": [
        "kind",
        "stages"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "lifecycle",
            "pipeline"
          ]
        },
        "role": {
          "enum": [
            "working",
            "landing",
            "record"
          ]
        },
        "on": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "manual": {
              "type": "object"
            },
            "schedule": {
              "type": "object",
              "required": [
                "cron"
              ],
              "additionalProperties": false,
              "properties": {
                "cron": {
                  "type": "string",
                  "description": "Five-field cron."
                },
                "standing": {
                  "type": "boolean",
                  "description": "Fire only under an enabled, eligible standing approval."
                },
                "skipIfActive": {
                  "type": "boolean"
                },
                "queue": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "aggressiveCron": {
                  "type": "string"
                }
              }
            },
            "publication": {
              "type": "object",
              "required": [
                "queue",
                "standing"
              ],
              "additionalProperties": false,
              "properties": {
                "queue": {
                  "type": "string",
                  "minLength": 1
                },
                "standing": {
                  "const": true
                }
              }
            }
          }
        },
        "workspace": {
          "enum": [
            "run",
            "project"
          ]
        },
        "defaults": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model": {
              "type": "string",
              "description": "provider/model for agent steps."
            },
            "thinking": {
              "type": "string"
            },
            "executor": {
              "type": "string",
              "enum": [
                "docker"
              ],
              "description": "Every project step runs in a container; docker is the only value."
            },
            "image": {
              "type": "string"
            }
          }
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "onEnter": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "uses"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uses": {
                      "$comment": "step-types"
                    },
                    "with": {
                      "type": "object",
                      "description": "The step kind's options: only the keys its kind takes (see allOf), checked when the workflow is saved (POST /api/v1/workflows/validate says what is wrong)."
                    }
                  },
                  "$comment": "step-options"
                }
              },
              "steps": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "uses"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uses": {
                      "$comment": "step-types"
                    },
                    "with": {
                      "type": "object",
                      "description": "The step kind's options: only the keys its kind takes (see allOf), checked when the workflow is saved (POST /api/v1/workflows/validate says what is wrong)."
                    }
                  },
                  "$comment": "step-options"
                }
              },
              "gate": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "require": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "stepOptionValues": {
      "agent/pi": {
        "repairRounds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "scan": {
        "baseline": {
          "const": "none"
        }
      },
      "workflow/call": {
        "whenFailed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "findings": {
          "const": "fixable"
        }
      },
      "fix": {
        "kind": {
          "$comment": "fix-kind"
        },
        "for": {
          "const": "findings"
        }
      }
    }
  }
}
