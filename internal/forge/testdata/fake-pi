#!/usr/bin/env python3
# The fake agent (design/architecture/testing-map.md): deterministic, free, obedient.
# Reads directives from its prompt (the last argument) and performs real
# edits in the real workspace; everything around it stays live machinery.
#
#   [test:write-b64 <path> <base64>]   write a file (dirs created)
#   [test:fail <message>]              exit nonzero after speaking
#
# Review prompts (they name .forge/review.json) get a pass verdict unless
# the workspace contains .forge/test-review-fail.
import base64, json, os, re, sys

prompt = sys.argv[-1] if len(sys.argv) > 1 else ""
did = []

for m in re.finditer(r"\[test:write-b64 (\S+) (\S+)\]", prompt):
    path, b64 = m.group(1), m.group(2)
    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    with open(path, "wb") as f:
        f.write(base64.b64decode(b64))
    did.append("wrote " + path)

if ".forge/review.json" in prompt or "review.json" in prompt:
    verdict = "pass"
    summary = "test reviewer: looks right"
    if os.path.exists(".forge/test-review-fail"):
        verdict, summary = "fail", "test reviewer: instructed to fail"
    os.makedirs(".forge", exist_ok=True)
    with open(".forge/review.json", "w") as f:
        json.dump({"verdict": verdict, "summary": summary, "findings": []}, f)
    did.append("verdict " + verdict)

fail = re.search(r"\[test:fail ?([^\]]*)\]", prompt)
text = "fake agent: " + ("; ".join(did) if did else "nothing directed")
if fail:
    text = "fake agent failing on purpose: " + fail.group(1)

print(json.dumps({"type": "message_end", "message": {
    "role": "assistant", "model": "fake/pi", "provider": "test",
    "content": [{"type": "text", "text": text}],
    "usage": {"input": 0, "output": 0}}}))
sys.exit(1 if fail else 0)
