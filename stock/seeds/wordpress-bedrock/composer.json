{
  "name": "forge/wordpress-bedrock",
  "type": "project",
  "description": "Immutable WordPress starter following Roots Bedrock 1.31.7 layout",
  "require": {
    "php": ">=8.3",
    "composer/installers": "^2.0",
    "roots/wordpress": "7.1.3",
    "humanmade/s3-uploads": "3.0.13"
  },
  "config": {
    "platform": {
      "php": "8.3.35"
    },
    "allow-plugins": {
      "composer/installers": true,
      "roots/wordpress-core-installer": true
    },
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "extra": {
    "wordpress-install-dir": "web/wp",
    "installer-paths": {
      "web/app/plugins/{$name}/": [
        "type:wordpress-plugin"
      ]
    }
  }
}
