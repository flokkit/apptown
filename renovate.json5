// Renovate: dependency updates for this repository, one at a time.
// design/operations/github.md ("Dependency updates") says how the dashboard,
// review and landing work. Nothing opens until a maintainer ticks it on the
// Dependency Dashboard issue; security fixes are the exception, one at a time.
//
// Project Go images and their central tool pin update together. Other central
// pins remain manual: downloads, checksums and qualified runtime images need
// their own coordinated update rules.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended', 'helpers:pinGitHubActionDigests'],
  timezone: 'Australia/Melbourne',

  // Admission: the dashboard lists every update; a person ticks one to open it.
  dependencyDashboard: true,
  dependencyDashboardApproval: true,
  prConcurrentLimit: 1,
  branchConcurrentLimit: 1,
  prHourlyLimit: 1,
  automerge: false,
  rebaseWhen: 'conflicted',
  minimumReleaseAge: '3 days',
  reviewers: ['bls'],

  enabledManagers: ['gomod', 'npm', 'github-actions', 'dockerfile', 'composer', 'custom.regex'],
  // Fixtures and evaluation material are not dependencies of anything shipped.
  ignorePaths: ['**/node_modules/**', '**/testdata/**', 'eval/**'],

  // The central Go pin follows the agent image's bookworm family. Scanner
  // images retain their own variant and publication dates; check-pins refuses
  // an update if the variants have not yet converged on the same version.
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: ['/^deploy/tool-pins\\.txt$/'],
      matchStrings: ['(?:^|\\n)golang[ \\t]+(?<currentValue>\\d+\\.\\d+\\.\\d+)[ \\t]+image golang(?:\\r?\\n|$)'],
      depNameTemplate: 'golang',
      datasourceTemplate: 'docker',
      versioningTemplate: 'semver',
      extractVersionTemplate: '^(?<version>\\d+\\.\\d+\\.\\d+)-bookworm$',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['/^stock/scanners\\.yaml$/'],
      matchStrings: ['(?:^|\\n)[ \\t]+image: golang:(?<currentValue>\\d+\\.\\d+\\.\\d+-alpine)(?:\\r?\\n|$)'],
      depNameTemplate: 'golang',
      datasourceTemplate: 'docker',
      versioningTemplate: 'docker',
    },
  ],

  // One group per thing to verify, for updates within a major version. A
  // major is left out of the groups, so it is its own pull request, except
  // where Renovate's monorepo groups (config:recommended) keep packages that
  // release together in one (react with react-dom). Later rules win.
  packageRules: [
    {
      matchManagers: ['gomod'],
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      groupName: 'Go modules',
    },
    {
      matchManagers: ['gomod'],
      postUpdateOptions: ['gomodTidy'],
    },
    {
      matchManagers: ['npm'],
      matchFileNames: ['web/**'],
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      groupName: 'web npm',
    },
    {
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['minor', 'patch', 'digest', 'pin', 'pinDigest'],
      groupName: 'GitHub Actions',
    },
    {
      matchManagers: ['dockerfile'],
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      groupName: 'Dockerfile bases',
    },
    {
      // A new Go line (1.26 to 1.27) in go.mod and the golang images is a
      // compiler change, verified apart from a digest refresh.
      matchManagers: ['gomod', 'dockerfile'],
      matchDepNames: ['go', 'golang'],
      matchUpdateTypes: ['minor'],
      groupName: 'Go toolchain',
    },
    {
      // A starter is verified as one thing: its image builds from its
      // Dockerfile and its npm or composer lockfile together.
      matchFileNames: ['stock/seeds/**'],
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      groupName: 'starter {{parentDir}}',
    },
    {
      // A starter's major stays apart from the same package's major in web/.
      matchFileNames: ['stock/seeds/**'],
      matchUpdateTypes: ['major'],
      additionalBranchPrefix: '{{parentDir}}-',
      commitMessageSuffix: '({{parentDir}} starter)',
    },
    {
      // Project tools are independent of AppTown's own build/CI compiler.
      // This overrides the broad Dockerfile and Go groups above.
      matchManagers: ['dockerfile', 'custom.regex'],
      matchFileNames: ['deploy/apptown-agent/Dockerfile', 'deploy/tool-pins.txt', 'stock/scanners.yaml'],
      matchPackageNames: ['golang'],
      groupName: 'project Go tools',
    },
  ],

  // Security fixes skip approval, the schedule and the release-age wait
  // (Renovate's defaults for this object); at most one is open at a time.
  vulnerabilityAlerts: {
    enabled: true,
    prConcurrentLimit: 1,
    assignees: ['bls'],
  },
}
