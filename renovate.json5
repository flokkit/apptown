// Dependency ownership and manual exceptions: design/operations/github.md.
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "timezone": "Australia/Melbourne",
  "dependencyDashboard": true,
  "dependencyDashboardApproval": true,
  "prConcurrentLimit": 1,
  "branchConcurrentLimit": 1,
  "prHourlyLimit": 1,
  "automerge": false,
  "lockFileMaintenance": {
    "enabled": true
  },
  "rebaseWhen": "conflicted",
  "minimumReleaseAge": "3 days",
  "reviewers": ["bls"],
  "enabledManagers": ["gomod", "npm", "github-actions", "dockerfile", "composer", "custom.regex", "mise", "docker-compose"],
  "ignorePaths": ["**/node_modules/**", "**/testdata/**", "eval/**"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^deploy/tool-pins\\.txt$/"],
      "matchStrings": ["(?:^|\\n)golang[ \\t]+(?<currentValue>\\d+\\.\\d+\\.\\d+)[ \\t]+image golang"],
      "depNameTemplate": "golang",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^(?<version>\\d+\\.\\d+\\.\\d+)-bookworm$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^stock/scanners\\.yaml$/"],
      "matchStrings": ["(?:^|\\n)[ \\t]+image: (?<depName>[^\\s:]+):(?<currentValue>[^\\s@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?"],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^internal/apptown/integration/connector_catalog\\.go$/"],
      "matchStrings": ["(?:\"image\":|Placeholder:)\\s*\"(?<depName>[^\"\\s:]+):(?<currentValue>[^\"\\s@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?\""],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^deploy/tool-pins\\.txt$/"],
      "matchStrings": ["(?:^|\\n)(?:node|osv-scanner|gitleaks|syft|trivy|semgrep|hadolint|godot|ruby)[ \\t]+(?<currentValue>\\S+)[ \\t]+image (?<depName>[^\\s,]+)"],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^deploy/apptown-agent/Dockerfile$/", "/^deploy/tool-pins\\.txt$/", "/^Makefile$/", "/^\\.github/workflows/ci\\.yml$/"],
      "matchStrings": ["# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\n(?:ARG \\w+_VERSION=|\\w+_VERSION := |[ \\t]+\\w+_VERSION: |\\S+[ \\t]+)(?<currentValue>\\S+)"]
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^deploy/apptown-agent/Dockerfile$/", "/^\\.github/workflows/ci\\.yml$/"],
      "matchStrings": ["# renovate: checksum=(?<depName>\\S+) version=(?<currentValue>\\S+)\\n(?:ARG \\w+_SHA256_\\w+=|[ \\t]+\\w+_SHA256: )(?<currentDigest>[a-f0-9]{64})"],
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^stock/toolchains/dotnet\\.toml$/"],
      "matchStrings": ["dotnet = \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "dotnet-sdk",
      "datasourceTemplate": "dotnet-version"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^stock/tool-versions\\.yaml$/"],
      "matchStrings": ["\\n  postgres:\\n    \"(?<depType>[^\"]+)\": \\{version: \"?(?<currentValue>[0-9.]+)\"?,"],
      "depNameTemplate": "postgres",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "extractVersionTemplate": "^(?<version>[0-9.]+)-alpine$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^stock/tool-versions\\.yaml$/"],
      "matchStrings": ["\\n  mariadb:\\n    \"(?<depType>[^\"]+)\": \\{version: \"?(?<currentValue>[0-9.]+)\"?,"],
      "depNameTemplate": "mariadb",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "extractVersionTemplate": "^(?<version>[0-9.]+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^stock/dependencies/postgres\\.yaml$/"],
      "matchStrings": ["  version: \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "postgres",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "extractVersionTemplate": "^(?<version>[0-9.]+)-alpine$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^stock/dependencies/mariadb\\.yaml$/"],
      "matchStrings": ["  version: \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "mariadb",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "extractVersionTemplate": "^(?<version>[0-9.]+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^stock/dependencies/redis\\.yaml$/"],
      "matchStrings": ["  version: \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "redis",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "extractVersionTemplate": "^(?<version>[0-9.]+)-alpine$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^stock/tool-versions\\.yaml$/"],
      "matchStrings": ["# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\n  [\\w-]+:\\n    \"(?<depType>[^\"]+)\": \\{version: (?<currentValue>[^,}\\s]+)"]
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^stock/tool-versions\\.yaml$/"],
      "matchStrings": ["run: \"(?<depName>[^\\s:@\"]+):(?<currentValue>[^@\"]+)@(?<currentDigest>sha256:[a-f0-9]+)\""],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^stock/tool-versions\\.yaml$/"],
      "matchStrings": ["\"1\": \\{version: (?<currentValue>[0-9.]+), images: \\{run: \"busybox@(?<currentDigest>sha256:[a-f0-9]+)\""],
      "depNameTemplate": "busybox",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^deploy/tool-pins\\.txt$/"],
      "matchStrings": ["(?:^|\\n)(?:alpine-git|caddy)[ \\t]+(?<currentValue>\\S+)[ \\t]+image (?<depName>[^\\s,]+)"],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Makefile$/"],
      "matchStrings": ["SEMGREP_IMAGE = (?<depName>[^\\s:]+):(?<currentValue>[^\\s@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?"],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^stock/(?:packs\\.yaml|dependencies/[^/]+\\.yaml)$/", "/^internal/dbtest/suite\\.go$/", "/^internal/apptown/dbboot\\.go$/"],
      "matchStrings": ["(?:image: |client: |\\\")(?<depName>[a-z][a-z0-9./-]*):(?<currentValue>v?[0-9][a-zA-Z0-9_.-]*)(?:@(?<currentDigest>sha256:[a-f0-9]+))?"],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^deploy/ci-heavy/Dockerfile$/"],
      "matchStrings": ["ARG PLAYWRIGHT_VERSION=(?<currentValue>\\S+)"],
      "depNameTemplate": "playwright",
      "datasourceTemplate": "npm",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^deploy/ci-heavy/Dockerfile$/"],
      "matchStrings": ["ARG DOCKER_BUILDX_VERSION=(?<currentValue>\\S+)\\nARG DOCKER_BUILDX_SHA256=(?<currentDigest>[a-f0-9]{64})"],
      "depNameTemplate": "docker/buildx",
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^deploy/ci-heavy/Dockerfile$/"],
      "matchStrings": ["ARG DOCKER_COMPOSE_VERSION=(?<currentValue>\\S+)\\nARG DOCKER_COMPOSE_SHA256=(?<currentDigest>[a-f0-9]{64})"],
      "depNameTemplate": "docker/compose",
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^deploy/ci-heavy/Dockerfile$/"],
      "matchStrings": ["ARG OXIPNG_VERSION=(?<version>\\S+)\\nARG OXIPNG_SHA256=(?<currentDigest>[a-f0-9]{64})"],
      "depNameTemplate": "shssoichiro/oxipng",
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "semver",
      "currentValueTemplate": "v{{{version}}}",
      "autoReplaceStringTemplate": "ARG OXIPNG_VERSION={{{replace '^v' '' newValue}}}\nARG OXIPNG_SHA256={{{newDigest}}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^stock/seeds/wordpress/Dockerfile$/"],
      "matchStrings": ["https://github.com/wp-cli/wp-cli/releases/download/(?<currentValue>v[0-9.]+)/wp-cli-[0-9.]+\\.phar -o /usr/local/bin/wp-cli.phar \\\\\\n    && echo \\'(?<currentDigest>[a-f0-9]{64})"],
      "depNameTemplate": "wp-cli/wp-cli",
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "semver",
      "autoReplaceStringTemplate": "https://github.com/wp-cli/wp-cli/releases/download/{{{newValue}}}/wp-cli-{{{replace '^v' '' newValue}}}.phar -o /usr/local/bin/wp-cli.phar \\\n    && echo '{{{newDigest}}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^stock/seeds/wordpress/composer\\.json$/"],
      "matchStrings": ["\"platform\": \\{\\s*\"php\": \"(?<currentValue>[0-9.]+)\""],
      "depNameTemplate": "php",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "extractVersionTemplate": "^(?<version>[0-9.]+)-apache-bookworm$"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "Go modules"
    },
    {
      "matchManagers": ["gomod"],
      "postUpdateOptions": ["gomodTidy"]
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["web/**"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "web npm"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "Dockerfile bases"
    },
    {
      "matchManagers": ["gomod", "dockerfile"],
      "matchDepNames": ["go", "golang"],
      "matchUpdateTypes": ["minor"],
      "groupName": "Go toolchain"
    },
    {
      "matchFileNames": ["stock/seeds/**"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "starter {{parentDir}}"
    },
    {
      "matchFileNames": ["stock/seeds/**"],
      "matchUpdateTypes": ["major"],
      "additionalBranchPrefix": "{{parentDir}}-",
      "commitMessageSuffix": "({{parentDir}} starter)"
    },
    {
      "matchManagers": ["dockerfile", "custom.regex"],
      "matchFileNames": ["deploy/apptown-agent/Dockerfile", "deploy/tool-pins.txt", "stock/scanners.yaml"],
      "matchPackageNames": ["golang"],
      "groupName": "project Go tools"
    },
    {
      "matchFileNames": ["deploy/apptown-agent/Dockerfile", "deploy/tool-pins.txt", "stock/scanners.yaml", "internal/apptown/integration/connector_catalog.go"],
      "matchPackageNames": ["node"],
      "groupName": "project Node tools"
    },
    {
      "matchFileNames": ["deploy/apptown-agent/Dockerfile", "deploy/tool-pins.txt", "stock/scanners.yaml", "internal/apptown/integration/connector_catalog.go"],
      "matchPackageNames": ["astral-sh/uv", "ghcr.io/astral-sh/uv"],
      "groupName": "project uv tools"
    },
    {
      "matchFileNames": ["deploy/apptown-agent/Dockerfile", "deploy/tool-pins.txt", "stock/scanners.yaml", "internal/apptown/integration/connector_catalog.go"],
      "matchPackageNames": ["jdx/mise"],
      "groupName": "project mise"
    },
    {
      "matchFileNames": ["deploy/apptown-agent/Dockerfile", "deploy/tool-pins.txt", "stock/scanners.yaml", "internal/apptown/integration/connector_catalog.go"],
      "matchPackageNames": ["DarthSim/hivemind"],
      "groupName": "project hivemind"
    },
    {
      "matchFileNames": ["deploy/apptown-agent/Dockerfile", "deploy/tool-pins.txt", "stock/scanners.yaml", "internal/apptown/integration/connector_catalog.go"],
      "matchPackageNames": ["docker/buildx"],
      "groupName": "project buildx"
    },
    {
      "matchFileNames": ["deploy/apptown-agent/Dockerfile", "deploy/tool-pins.txt", "stock/scanners.yaml", "internal/apptown/integration/connector_catalog.go"],
      "matchPackageNames": ["docker/compose"],
      "groupName": "project compose"
    },
    {
      "matchFileNames": ["deploy/apptown-agent/Dockerfile", "deploy/tool-pins.txt", "stock/scanners.yaml", "internal/apptown/integration/connector_catalog.go"],
      "matchPackageNames": ["ruff"],
      "groupName": "project ruff"
    },
    {
      "matchFileNames": ["deploy/apptown-agent/Dockerfile", "deploy/tool-pins.txt", "stock/scanners.yaml", "internal/apptown/integration/connector_catalog.go"],
      "matchPackageNames": ["@biomejs/biome"],
      "groupName": "project biome"
    },
    {
      "matchFileNames": ["deploy/apptown-agent/Dockerfile", "deploy/tool-pins.txt", "stock/scanners.yaml", "internal/apptown/integration/connector_catalog.go"],
      "matchPackageNames": ["golang.org/x/tools/gopls"],
      "groupName": "project gopls"
    },
    {
      "matchFileNames": ["deploy/apptown-agent/Dockerfile", "deploy/tool-pins.txt", "stock/scanners.yaml", "internal/apptown/integration/connector_catalog.go"],
      "matchPackageNames": ["@earendil-works/pi-coding-agent", "pi-subagents", "@narumitw/pi-lsp"],
      "groupName": "project pi tools"
    },
    {
      "matchFileNames": ["deploy/apptown-agent/Dockerfile", "deploy/tool-pins.txt", "stock/scanners.yaml", "internal/apptown/integration/connector_catalog.go"],
      "matchPackageNames": ["ghcr.io/google/osv-scanner"],
      "groupName": "project scanner osv-scanner"
    },
    {
      "matchFileNames": ["deploy/apptown-agent/Dockerfile", "deploy/tool-pins.txt", "stock/scanners.yaml", "internal/apptown/integration/connector_catalog.go"],
      "matchPackageNames": ["zricethezav/gitleaks"],
      "groupName": "project scanner gitleaks"
    },
    {
      "matchFileNames": ["deploy/apptown-agent/Dockerfile", "deploy/tool-pins.txt", "stock/scanners.yaml", "internal/apptown/integration/connector_catalog.go"],
      "matchPackageNames": ["anchore/syft"],
      "groupName": "project scanner syft"
    },
    {
      "matchFileNames": ["deploy/apptown-agent/Dockerfile", "deploy/tool-pins.txt", "stock/scanners.yaml", "internal/apptown/integration/connector_catalog.go"],
      "matchPackageNames": ["aquasec/trivy"],
      "groupName": "project scanner trivy"
    },
    {
      "matchFileNames": ["deploy/apptown-agent/Dockerfile", "deploy/tool-pins.txt", "stock/scanners.yaml", "internal/apptown/integration/connector_catalog.go"],
      "matchPackageNames": ["semgrep/semgrep"],
      "groupName": "project scanner semgrep"
    },
    {
      "matchFileNames": ["deploy/apptown-agent/Dockerfile", "deploy/tool-pins.txt", "stock/scanners.yaml", "internal/apptown/integration/connector_catalog.go"],
      "matchPackageNames": ["hadolint/hadolint"],
      "groupName": "project scanner hadolint"
    },
    {
      "matchFileNames": ["deploy/apptown-agent/Dockerfile", "deploy/tool-pins.txt", "stock/scanners.yaml", "internal/apptown/integration/connector_catalog.go", "stock/tool-versions.yaml"],
      "matchPackageNames": ["barichello/godot-ci"],
      "groupName": "project scanner godot-ci",
      "allowedVersions": "/^4\\.4(?:\\.|-|$)/"
    },
    {
      "matchFileNames": ["deploy/apptown-agent/Dockerfile", "deploy/tool-pins.txt", "stock/scanners.yaml", "internal/apptown/integration/connector_catalog.go"],
      "matchPackageNames": ["ruby"],
      "groupName": "project scanner ruby"
    },
    {
      "matchFileNames": ["Makefile"],
      "groupName": "build tool {{depName}}"
    },
    {
      "matchFileNames": [".github/workflows/ci.yml"],
      "matchPackageNames": ["gitleaks/gitleaks"],
      "groupName": "CI gitleaks"
    },
    {
      "matchFileNames": ["deploy/tool-pins.txt"],
      "matchPackageNames": ["hadolint/hadolint"],
      "extractVersion": "^(?<version>v?[0-9.]+)-alpine$"
    },
    {
      "matchFileNames": ["stock/**"],
      "matchManagers": ["mise", "custom.regex"],
      "matchPackageNames": ["golang/go", "go"],
      "allowedVersions": "/^1\\.27(?:\\.|$)/",
      "groupName": "stock Go 1.27"
    },
    {
      "matchFileNames": ["stock/toolchains/**", "stock/tool-versions.yaml"],
      "matchPackageNames": ["node"],
      "allowedVersions": "/^24(?:\\.|$)/",
      "groupName": "stock Node 24"
    },
    {
      "matchFileNames": ["stock/toolchains/**", "stock/tool-versions.yaml", "stock/dependencies/**"],
      "matchPackageNames": ["python/cpython", "python"],
      "allowedVersions": "/^3\\.12(?:\\.|\\+|-|$)/",
      "groupName": "stock Python 3.12"
    },
    {
      "matchFileNames": ["stock/toolchains/**", "stock/tool-versions.yaml", "stock/dependencies/**"],
      "matchPackageNames": ["java-jdk"],
      "allowedVersions": "/^21(?:\\.|\\+|-|$)/",
      "groupName": "stock Java 21"
    },
    {
      "matchFileNames": ["stock/toolchains/**", "stock/tool-versions.yaml", "stock/dependencies/**"],
      "matchPackageNames": ["apache/maven"],
      "extractVersion": "^maven-(?<version>[0-9]+\\.[0-9]+\\.[0-9]+)$",
      "allowedVersions": "/^3\\.9(?:\\.|\\+|-|$)/",
      "groupName": "stock Maven 3.9"
    },
    {
      "matchFileNames": ["stock/toolchains/**", "stock/tool-versions.yaml", "stock/dependencies/**"],
      "matchPackageNames": ["dotnet-sdk", "dotnet-runtime"],
      "allowedVersions": "/^10(?:\\.|\\+|-|$)/",
      "groupName": "stock dotnet 10"
    },
    {
      "matchFileNames": ["stock/toolchains/**", "stock/tool-versions.yaml", "stock/dependencies/**"],
      "matchPackageNames": ["ruby-version", "ruby"],
      "allowedVersions": "/^3\\.4(?:\\.|\\+|-|$)/",
      "groupName": "stock Ruby 3.4"
    },
    {
      "matchFileNames": ["stock/toolchains/**", "stock/tool-versions.yaml", "stock/dependencies/**"],
      "matchPackageNames": ["rust"],
      "allowedVersions": "/^1\\.84(?:\\.|\\+|-|$)/",
      "groupName": "stock Rust 1.84"
    },
    {
      "matchFileNames": ["stock/toolchains/**", "stock/tool-versions.yaml", "stock/dependencies/**"],
      "matchPackageNames": ["php"],
      "allowedVersions": "/^8\\.3(?:\\.|\\+|-|$)/",
      "groupName": "stock PHP 8.3"
    },
    {
      "matchFileNames": ["stock/toolchains/**", "stock/tool-versions.yaml", "stock/dependencies/**"],
      "matchPackageNames": ["postgres"],
      "allowedVersions": "/^16(?:\\.|\\+|-|$)/",
      "groupName": "stock Postgres 16"
    },
    {
      "matchFileNames": ["stock/toolchains/**", "stock/tool-versions.yaml", "stock/dependencies/**"],
      "matchPackageNames": ["mariadb"],
      "allowedVersions": "/^11\\.4(?:\\.|\\+|-|$)/",
      "groupName": "stock MariaDB 11.4"
    },
    {
      "matchFileNames": ["stock/toolchains/**", "stock/tool-versions.yaml", "stock/dependencies/**"],
      "matchPackageNames": ["redis"],
      "allowedVersions": "/^7(?:\\.|\\+|-|$)/",
      "groupName": "stock Redis 7"
    },
    {
      "matchFileNames": ["stock/toolchains/node.toml", "stock/toolchains/python.toml", "stock/toolchains/ruby.toml", "stock/toolchains/dotnet.toml", "stock/dependencies/postgres.yaml", "stock/dependencies/redis.yaml", "stock/dependencies/mariadb.yaml"],
      "enabled": false
    },
    {
      "matchFileNames": ["stock/tool-versions.yaml", "deploy/tool-pins.txt"],
      "matchPackageNames": ["alpine/git"],
      "allowedVersions": "/^v?2(?:\\.|$)/",
      "groupName": "runtime Alpine Git"
    },
    {
      "matchFileNames": ["stock/tool-versions.yaml", "deploy/tool-pins.txt"],
      "matchPackageNames": ["busybox"],
      "allowedVersions": "/^1(?:\\.|$)/",
      "groupName": "runtime BusyBox"
    },
    {
      "matchFileNames": ["stock/tool-versions.yaml", "deploy/tool-pins.txt"],
      "matchPackageNames": ["caddy"],
      "allowedVersions": "/^2(?:\\.|$)/",
      "groupName": "runtime Caddy"
    },
    {
      "matchFileNames": ["stock/tool-versions.yaml", "deploy/tool-pins.txt", "deploy/apptown-agent/Dockerfile"],
      "matchPackageNames": ["docker"],
      "allowedVersions": "/^27(?:\\.|$)/",
      "groupName": "runtime private Docker 27",
      "prBodyNotes": ["Docker CLI archive checksums require manual verification for both architectures. A changed private daemon is accepted only after the external-worker private Docker tests (internal/worker, TestIntegrationExternalWorker) pass against it."]
    },
    {
      "matchFileNames": ["deploy/Dockerfile"],
      "matchPackageNames": ["docker"],
      "allowedVersions": "/^29(?:\\.|$)/",
      "groupName": "deployment Docker 29",
      "prBodyNotes": ["These CLI and daemon bases are separate from the private Docker runtime. Runtime and deployment acceptance remain manual."]
    },
    {
      "matchManagers": ["gomod"],
      "matchDepTypes": ["indirect"],
      "enabled": true
    },
    {
      "description": "App runtime, scanner execution and starter base changes need qualification before landing; dashboard approval only opens a proposal.",
      "matchDatasources": ["docker"],
      "automerge": false,
      "addLabels": ["qualification-required"]
    },
    {
      "description": "Stock language versions change the environment apps build and run in; qualify even patch releases.",
      "matchFileNames": ["stock/toolchains/**", "stock/tool-versions.yaml", "stock/dependencies/**"],
      "automerge": false,
      "addLabels": ["qualification-required"]
    },
    {
      "matchFileNames": ["deploy/ci-heavy/Dockerfile"],
      "matchDatasources": ["npm", "github-release-attachments"],
      "groupName": "heavy CI tools"
    },
    {
      "matchFileNames": ["stock/packs.yaml"],
      "matchPackageNames": ["mariadb"],
      "groupName": "stock MariaDB 11.4",
      "allowedVersions": "/^11\\.4(?:\\.|$)/"
    },
    {
      "description": "Pack PostgreSQL selectors and the test database deliberately track major 16; adding a line requires a deliberate compatibility decision.",
      "matchFileNames": ["stock/packs.yaml", "internal/dbtest/suite.go", "internal/apptown/dbboot.go"],
      "matchPackageNames": ["postgres"],
      "allowedVersions": "/^16(?:\\.|-|$)/",
      "groupName": "Postgres 16 images"
    },
    {
      "description": "The Composer platform version must follow the PHP image that runs the WordPress starter.",
      "matchFileNames": ["stock/seeds/wordpress/**"],
      "matchPackageNames": ["php"],
      "allowedVersions": "/^8\\.3(?:\\.|-|$)/",
      "groupName": "WordPress PHP runtime",
      // A regex manager does not regenerate composer.lock, whose content hash includes config.platform.
      "prBodyNotes": ["Before landing, run `composer update --lock` in stock/seeds/wordpress so composer.lock matches the new platform PHP version."]
    },
    {
      "description": "S3 copy tooling uses Python 3.13 independently of the stock Python 3.12 language line.",
      "matchFileNames": ["stock/dependencies/s3.yaml"],
      "matchPackageNames": ["python"],
      "allowedVersions": "/^3\\.13(?:\\.|-|$)/",
      "groupName": "S3 Python client"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "prConcurrentLimit": 1,
    "assignees": ["bls"]
  },
  "mise": {
    "managerFilePatterns": ["/^stock/toolchains/[^/]+\\.toml$/"]
  }
}
